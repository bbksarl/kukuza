VITE_SITE_URL=https://kukuza.com
VITE_API_BASE_URL=/api
KUKUZA_API_PROXY_TARGET=https://localhost:7200
KUKUZA_API_PROXY_INSECURE=false
VITE_ENABLE_API_MOCKS=false
VITE_API_TIMEOUT=15000
VITE_DEFAULT_CURRENCY=EUR
VITE_BRAND_METRICS_PATH=/brands/{brandId}/metrics
VITE_BRAND_PRODUCTS_PATH=/brands/{brandId}/products
VITE_BRAND_CATEGORIES_PATH=/brands/{brandId}/categories
VITE_PRODUCT_PATH=/Product/{productId}
VITE_CATEGORY_PATH=/Category/{categoryId}
VITE_DEFAULT_ADMIN_EMAIL=admin@example.local
VITE_DEFAULT_ADMIN_PASSWORD=change-this-local-password
VITE_DEFAULT_BOUTIQUE_EMAIL=boutique@example.local
VITE_DEFAULT_BOUTIQUE_PASSWORD=change-this-local-password
