{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false },
  "projects": {
    "kukuza": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "index.html",
            "tsConfig": "tsconfig.app.json",
            "outputPath": { "base": "dist", "browser": "browser" },
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "**/*",
                "input": "src/assets",
                "output": "assets"
              }
            ],
            "styles": ["src/design-system/app.css"],
            "inlineStyleLanguage": "css",
            "conditions": ["style"],
            "server": "src/main.server.ts",
            "outputMode": "server",
            "security": {
              "allowedHosts": []
            },
            "ssr": {
              "entry": "src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": { "minify": true, "inlineCritical": false },
                "fonts": false
              },
              "budgets": [{ "type": "initial", "maximumWarning": "1mb", "maximumError": "1.5mb" }]
            },
            "development": { "optimization": false, "sourceMap": true, "extractLicenses": false },
            "demo": { "outputMode": "static" }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": { "port": 3000, "host": "127.0.0.1", "proxyConfig": "proxy.generated.json" },
          "configurations": {
            "development": { "buildTarget": "kukuza:build:development" },
            "production": { "buildTarget": "kukuza:build:production" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
