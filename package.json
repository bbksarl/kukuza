{
  "name": "kukuza-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/environment.mjs development",
    "dev": "ng serve --configuration development",
    "pretypecheck": "node scripts/ensure-environment.mjs",
    "typecheck": "ng build --configuration development",
    "prebuild": "node scripts/environment.mjs production",
    "build": "ng build --configuration production",
    "prebuild:demo": "node scripts/environment.mjs demo",
    "build:demo": "ng build --configuration production,demo",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "e2e": "playwright test",
    "format": "prettier --write \"src/**/*.{ts,html,css}\" \"scripts/**/*.{mjs,ts}\" \"e2e/**/*.ts\" angular.json package.json tsconfig.json tsconfig.app.json vitest.config.ts playwright.config.ts README.md .gitlab-ci.yml vercel.json",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\" \"scripts/**/*.{mjs,ts}\" \"e2e/**/*.ts\" angular.json package.json tsconfig.json tsconfig.app.json vitest.config.ts playwright.config.ts README.md .gitlab-ci.yml vercel.json",
    "lint": "eslint src scripts e2e playwright.config.ts --max-warnings=0",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@angular/common": "21.2.26",
    "@angular/compiler": "21.2.26",
    "@angular/core": "21.2.26",
    "@angular/forms": "21.2.26",
    "@angular/platform-browser": "21.2.26",
    "@angular/platform-server": "21.2.26",
    "@angular/router": "21.2.26",
    "@angular/ssr": "21.2.26",
    "express": "^5.1.0",
    "rxjs": "7.8.2",
    "tslib": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@angular/build": "21.2.26",
    "@angular/cli": "21.2.26",
    "@angular/compiler-cli": "21.2.26",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^10.13.0",
    "globals": "^16.5.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.8",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "overrides": {
    "@angular/build": {
      "undici": "^7.30.2"
    },
    "@modelcontextprotocol/sdk": "^1.32.2",
    "glob": ">=14.0.2 <15",
    "minimatch": ">=11.0.1 <12",
    "vite": "$vite",
    "zod": "$zod"
  }
}
